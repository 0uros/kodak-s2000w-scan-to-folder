# Generated by kodak-s2000w-scan-to-folder/server/install.sh. Shares are appended below.
[global]
   workgroup = WORKGROUP
   server string = Scans
   server role = standalone server
   security = user
   map to guest = never
   restrict anonymous = 2
   # Windows 11 24H2 requires signing and refuses guest access: SMB2/3 with negotiated signing.
   server min protocol = SMB2_10
   server signing = auto
   disable netbios = yes
   smb ports = 445
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/%m.log
   max log size = 1000
   logging = file

   # Everything is written as the "scans" user so the services and the PCs share permissions.
   force user = scans
   force group = scans
   create mask = 0660
   force create mode = 0660
   directory mask = 2770
   force directory mode = 2770
   # Recycle bin: deleted files go to .recycle and are purged after 30 days (tmpfiles).
   vfs objects = recycle
   recycle:repository = .recycle
   recycle:keeptree = yes
   recycle:versions = yes
   recycle:touch = yes
   recycle:touch_mtime = yes
   recycle:directory_mode = 2770
   # Linux file managers cannot create their own trash (.Trash-<uid>) in the shares: they ask to
   # "delete permanently" and the file still lands in .recycle. One recycle bin, purged on schedule.
   veto files = /.Trash-*/.Trash/
