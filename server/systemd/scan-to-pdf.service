# Turns finished scan batches into searchable PDFs in the shared folders.
[Unit]
Description=Scan batches -> searchable PDF
After=local-fs.target

[Service]
User=scans
Group=scans
UMask=0007
ExecStart=/usr/bin/python3 @APP@/scan-to-pdf.py
Restart=always
RestartSec=10
Nice=5
ProtectSystem=strict
ReadWritePaths=@DATA@
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
